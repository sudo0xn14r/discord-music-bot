DISCORD_TOKEN=
# Optional. Set your server id so slash commands update immediately.
# Leave this empty to register commands globally (can take up to an hour).
GUILD_ID=
# Optional. Discord user id that receives a direct message if Lavalink stays down.
OWNER_ID=

# Lavalink is the audio server. It does not provide music by itself.
# The password must match lavalink/application.yml (password under lavalink.server).
LAVALINK_PASSWORD=changeme
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
# LAVALINK_SECURE=false

# Playback sources, in order. Spotify, Apple Music, and Deezer are metadata only.
# local plays files in LOCAL_MUSIC_DIR.
# soundcloud uses the official API when the client id below is set.
# lavalink plays SoundCloud, Bandcamp, Twitch, Vimeo, and public HTTP links, and searches SoundCloud.
PROVIDER_ORDER=local,soundcloud,lavalink
LOCAL_MUSIC_DIR=music
DATABASE_PATH=data/bot.sqlite

# Leave the voice channel after this many minutes with nobody listening, or with an empty queue.
# 0 disables auto-leave.
IDLE_MINUTES=10
# Optional HTTP address that receives a GET every 30 seconds. Do not commit a secret URL.
# UPTIME_URL=

# SoundCloud developer app. Used for official API search and playback.
# SoundCloud, Bandcamp, Twitch, and Vimeo links still resolve through Lavalink with no login.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Spotify developer app. Metadata only, for the bot and for the LavaSrc plugin.
# The bot never streams Spotify audio. Apple Music and Deezer need no keys.
# Put the same file on the Lavalink systemd unit so these values reach the plugin.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
