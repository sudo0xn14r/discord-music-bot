DISCORD_TOKEN=
# Optional. Set your server id so slash commands update immediately.
# Leave this empty to register commands globally (can take up to an hour).
GUILD_ID=
# Optional. Discord user id that receives a direct message if Lavalink stays down.
OWNER_ID=

# Lavalink is the audio server. It does not provide music by itself.
# The password must match lavalink/application.yml (password under lavalink.server).
LAVALINK_PASSWORD=changeme
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
# LAVALINK_SECURE=false

# Playback sources, in order. Spotify is not a playback source.
# local plays files in LOCAL_MUSIC_DIR. soundcloud plays tracks its API allows.
PROVIDER_ORDER=local,soundcloud
LOCAL_MUSIC_DIR=music
DATABASE_PATH=data/bot.sqlite

# SoundCloud developer app. Playback works only for tracks the API marks as streamable.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Spotify developer app. Used for track, album, and playlist metadata only.
# The bot never streams Spotify audio. It searches the local library, then SoundCloud.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
